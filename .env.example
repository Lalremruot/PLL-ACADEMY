# Server-only AES-256-GCM encryption key used to encrypt Razorpay credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RAZORPAY_ENCRYPTION_KEY=

# Secret used to HMAC-sign httpOnly session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# MongoDB connection string (optional; falls back to a default when unset)
MONGODB_URI=

# --- Primary administrator (REQUIRED for production) ---
# Seeded into MongoDB on first login and used as the fallback while MongoDB is
# unreachable. Managers and parents are created by the admin/system through the UI.
# If ADMIN_EMAIL or ADMIN_PASSWORD is not set, the primary admin is never seeded
# and the env fallback login is disabled (fail closed) — no default credential
# can authenticate. Set BOTH and use a strong, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name for the primary admin (defaults to "Academy Administrator").
# ADMIN_NAME=

# --- Razorpay credentials (optional) ---
# When RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are both set they take priority
# over anything saved in the admin Settings panel, and the key secret is never
# written to the database. The Settings fields render read-only in that case.
# Recommended for production; leave unset to configure through the admin UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for /api/razorpay/webhook to accept Razorpay's payment.captured events.
RAZORPAY_WEBHOOK_SECRET=
# Optional. Defaults to Test only for an rzp_test_ key; anything else is Live.
RAZORPAY_MODE=

# Shared secret for the scheduled auto-debit run (vercel.json -> /api/cron/process-recurring).
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET`.
# Unset means the cron endpoint refuses every request, so scheduled billing is off.
CRON_SECRET=
