# Server-only AES-256-GCM encryption key used to encrypt Razorpay credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RAZORPAY_ENCRYPTION_KEY=

# Secret used to HMAC-sign httpOnly session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# MongoDB connection string (optional; falls back to a default when unset)
MONGODB_URI=

# --- Razorpay credentials (optional) ---
# When RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are both set they take priority
# over anything saved in the admin Settings panel, and the key secret is never
# written to the database. The Settings fields render read-only in that case.
# Recommended for production; leave unset to configure through the admin UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for /api/razorpay/webhook to accept Razorpay's payment.captured events.
RAZORPAY_WEBHOOK_SECRET=
# Optional. Defaults to Test only for an rzp_test_ key; anything else is Live.
RAZORPAY_MODE=
